# Client Environment Variables
# Optional: Sentry DSN for error tracking (leave blank to disable)
VITE_SENTRY_DSN=

# Optional: backend that /api requests are routed to.
# - Locally: the vite dev/preview server proxies /api here.
#   Defaults: dev → http://localhost:3001, preview → the production Render URL.
# - On Vercel: middleware.js reads the same variable (set it per-environment in
#   the dashboard — e.g. Preview → the Render PR-preview backend URL). Unset,
#   deployments fall back to the static vercel.json rewrite (production URL).
#   BACKEND_URL=https://my-temp-backend.onrender.com
BACKEND_URL=
