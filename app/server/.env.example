# Server
PORT=3001
# Hard upload limit in MB — increase or add chunking support as needed
MAX_FILE_SIZE_MB=500
# Absolute or relative path where per-video folders are created
VIDEOS_DIR=./videos

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=
NODE_ENV=development

# STT Provider API Keys
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
SONIX_API_KEY=
SPEECHMATICS_API_KEY=
MISTRAL_API_KEY=
REVAI_ACCESS_TOKEN=
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
XAI_API_KEY=

GOOGLE_API_KEY=

# Thumbnail POC — vision rerank + image-gen polish
# Either key is optional; pipeline degrades gracefully (skips missing provider).
GEMINI_API_KEY=
# OPENAI_API_KEY above is reused for gpt-image-1 polish.

# Clips POC — LLM clip suggestion from transcript.
# Reuses OPENAI_API_KEY (gpt-4.1-mini) and GEMINI_API_KEY (gemini-2.5-pro);
# the user picks which provider generates clip suggestions. No extra keys.