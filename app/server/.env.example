# Server
PORT=3001
# Hard upload limit in MB — checked before minting an upload URL, and re-checked
# post-hoc after upload (a presigned PUT/UploadPart URL carries no size condition
# S3 enforces itself, unlike the old presigned-POST policy, so we HEAD the object
# once it lands and delete it if it's over the limit).
MAX_FILE_SIZE_MB=500

# Storage (S3) — REQUIRED, server refuses to start without bucket + region.
# All session artifacts (original video, audio, transcriptions, burned video,
# thumbnails, clips, JSON state) live in this bucket under <S3_KEY_PREFIX><videoId>/.
AWS_REGION=us-east-1
S3_BUCKET=

# Credentials: omit BOTH to use an IAM role / instance profile on AWS.
# For local dev, set both to an IAM user with s3:{Put,Get,Head,List,Delete}Object.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional key prefix inside the bucket, e.g. "videos/" (trailing slash optional).
S3_KEY_PREFIX=

# Presigned URL TTL for browser UPLOADS, seconds — covers both the single-PUT
# and multipart-part-PUT URLs. (GET delivery uses public URLs, no presign.)
S3_PRESIGN_EXPIRES_S=3600

# Optional public base URL for GET delivery. Defaults to the bucket's S3 website
# host (https://<bucket>.s3.<region>.amazonaws.com). Point this at a CloudFront
# domain later to serve via CDN.
S3_PUBLIC_BASE_URL=

# Local scratch dir for ffmpeg/transcode work (ephemeral, wiped per request).
# Defaults to <os.tmpdir()>/sp-video-work when blank.
TMP_WORK_DIR=
#
# ── Bucket setup (one-time) ──────────────────────────────────────────────────
# Delivery is via PUBLIC-READ objects fetched directly by the browser with HTTP
# Range (native video scrubbing), so:
#  1. Disable Block Public Access toggles BlockPublicPolicy + RestrictPublicBuckets.
#  2. Bucket policy granting public read (scope to the prefix if you set one):
#       { "Effect":"Allow","Principal":"*","Action":"s3:GetObject",
#         "Resource":"arn:aws:s3:::<bucket>/*" }
#     Keep s3:ListBucket PRIVATE so object keys aren't enumerable.
#  3. CORS (needed for the browser direct UPLOAD; tag playback needs no CORS).
#     ExposeHeaders MUST include ETag — the client reads it off each part's PUT
#     response to complete a multipart upload:
#       [{ "AllowedMethods": ["GET","HEAD","POST","PUT"],
#          "AllowedOrigins": ["http://localhost:5173","https://<your-client-domain>"],
#          "AllowedHeaders": ["*"], "ExposeHeaders": ["ETag"] }]
#  4. Recommended: an AbortIncompleteMultipartUpload lifecycle rule (e.g. 3 days).
#     The app aborts failed multipart uploads itself, but this is a backstop for
#     the case where the browser tab closes mid-upload and that call never fires:
#       { "Rules": [{ "ID": "abort-incomplete-mpu", "Status": "Enabled",
#           "AbortIncompleteMultipartUpload": { "DaysAfterInitiation": 3 } }] }

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=
NODE_ENV=development

# Auth (REQUIRED — server refuses to start without these)
# Single login user. Password is stored only as a bcrypt hash, never plaintext.
# Generate the hash with: node scripts/gen-password-hash.js '<your-password>'
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Secret for signing session JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# STT Provider API Keys
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
SONIX_API_KEY=
SPEECHMATICS_API_KEY=
MISTRAL_API_KEY=
REVAI_ACCESS_TOKEN=
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
XAI_API_KEY=

GOOGLE_API_KEY=

# Thumbnail POC — vision rerank + image-gen polish
# Either key is optional; pipeline degrades gracefully (skips missing provider).
GEMINI_API_KEY=
# OPENAI_API_KEY above is reused for gpt-image-1 polish.

# Clips POC — two methods, no extra keys:
#  1. Subtitles — reads the transcript. OPENAI_API_KEY or GEMINI_API_KEY.
#  2. Video understanding — Gemini watches the raw video (Files API upload +
#     gemini-2.5-flash). Needs GEMINI_API_KEY with BILLING ENABLED (video tokens).
# FFmpeg re-encode tuning (burn, clip cut). Defaults are sized for small
# containers (1 thread, veryfast ≈ 260MB peak at 1080p — fits 512MB instances).
# Raise on bigger machines for faster encodes.
FFMPEG_THREADS=1
FFMPEG_PRESET=veryfast

# ── SmartCrop API (/api/smartcrop) — spec: .claude/spec/00–04 ─────────────────
# Opt-in. When "true" the server refuses to start unless every REQUIRED value
# below is set; when unset/false the router isn't mounted at all.
SMARTCROP_ENABLED=false
# REQUIRED when enabled (AWS_REGION + credentials above are shared)
SMARTCROP_IN_BUCKET=
SMARTCROP_JOBS_BUCKET=
SMARTCROP_OUT_BUCKET=
PIPELINE_JOBS_TABLE=
STATE_MACHINE_ARN=
PLAN_LAMBDA_FUNCTION=
# Optional (defaults shown). Create the two API tables once with:
#   node scripts/smartcrop-create-tables.js
PROJECTS_TABLE=smartcrop-api-projects
RENDERS_TABLE=smartcrop-api-renders
# Deployed pipeline changes, comma list of: skip_render, edit, editor_media
PIPELINE_FEATURES=
PIPELINE_PLAN_VERSION=1
# Origins for the one-time bucket CORS setup below (the API itself doesn't read it)
CORS_ORIGINS=http://localhost:5173
SIGNED_URL_TTL_SEC=3600
UPLOAD_PART_SIZE_BYTES=16777216
UPLOAD_MAX_BYTES=4294967296
UPLOAD_EXPIRY_HOURS=24
VIDEO_MIN_DURATION_MS=3000
VIDEO_MAX_DURATION_MS=1800000
VIDEO_MIN_SHORT_SIDE_PX=360
VIDEO_MAX_LONG_SIDE_PX=3840
PREVIEW_TIMEOUT_MS=30000
PREVIEW_MAX_INFLIGHT_PER_PROJECT=2
STATUS_REFRESH_MIN_MS=3000
MIN_CLIP_MS=200
MAX_CLIPS=500
#
# SmartCrop bucket setup (one-time, spec 00 §4):
#  - Lifecycle: expire */previews/ after 7 days (JOBS); abort incomplete
#    multipart uploads after 1 day (IN).
#  - CORS on all 3 buckets: AllowedOrigins = CORS_ORIGINS, methods GET/HEAD/PUT,
#    headers *, ExposeHeaders ETag, Content-Length, Content-Range, Accept-Ranges.
#  - Buckets stay private: every URL the API hands out is presigned.
# IAM: s3 get/put/delete/list + multipart on the 3 buckets; dynamodb read/write
# on the 2 API tables + GetItem on PIPELINE_JOBS_TABLE; states:StartExecution/
# DescribeExecution/GetExecutionHistory/StopExecution; lambda:InvokeFunction.
