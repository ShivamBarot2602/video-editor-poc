# Server
PORT=3001
# Hard upload limit in MB — enforced server-side AND at S3 (presigned-POST policy)
MAX_FILE_SIZE_MB=500

# Storage (S3) — REQUIRED, server refuses to start without bucket + region.
# All session artifacts (original video, audio, transcriptions, burned video,
# thumbnails, clips, JSON state) live in this bucket under <S3_KEY_PREFIX><videoId>/.
AWS_REGION=us-east-1
S3_BUCKET=

# Credentials: omit BOTH to use an IAM role / instance profile on AWS.
# For local dev, set both to an IAM user with s3:{Put,Get,Head,List,Delete}Object.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional key prefix inside the bucket, e.g. "videos/" (trailing slash optional).
S3_KEY_PREFIX=

# Presigned media-delivery URL TTL, seconds (GET redirects + upload POST policy).
S3_PRESIGN_EXPIRES_S=3600

# Local scratch dir for ffmpeg/transcode work (ephemeral, wiped per request).
# Defaults to <os.tmpdir()>/sp-video-work when blank.
TMP_WORK_DIR=
#
# Bucket CORS (required for browser direct upload + presigned playback). Set on
# the bucket once, allowing your client origin:
#   [{ "AllowedMethods": ["GET","HEAD","POST","PUT"],
#      "AllowedOrigins": ["http://localhost:5173","https://<your-client-domain>"],
#      "AllowedHeaders": ["*"], "ExposeHeaders": ["ETag"] }]

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=
NODE_ENV=development

# Auth (REQUIRED — server refuses to start without these)
# Single login user. Password is stored only as a bcrypt hash, never plaintext.
# Generate the hash with: node scripts/gen-password-hash.js '<your-password>'
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Secret for signing session JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# STT Provider API Keys
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
GLADIA_API_KEY=
SONIX_API_KEY=
SPEECHMATICS_API_KEY=
MISTRAL_API_KEY=
REVAI_ACCESS_TOKEN=
PYANNOTE_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=
XAI_API_KEY=

GOOGLE_API_KEY=

# Thumbnail POC — vision rerank + image-gen polish
# Either key is optional; pipeline degrades gracefully (skips missing provider).
GEMINI_API_KEY=
# OPENAI_API_KEY above is reused for gpt-image-1 polish.

# Clips POC — two methods, no extra keys:
#  1. Subtitles — reads the transcript. OPENAI_API_KEY or GEMINI_API_KEY.
#  2. Video understanding — Gemini watches the raw video (Files API upload +
#     gemini-2.5-flash). Needs GEMINI_API_KEY with BILLING ENABLED (video tokens).